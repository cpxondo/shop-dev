{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "useDefineForClassFields": false
  },
  "references": [
    { "path": "./src/tsconfig.app.json" },
    { "path": "./src/tsconfig.spec.json" }
  ]
}
